*/* **************************************************************** */ 00400000
*/*                                                                  */ 00500000
*/*                    JOB FILE CONTROL BLOCK                        */ 00600000
*/*                                                                  */ 00700000
*/*  OS/VS2 038 PTF                                          @YA05186*/ 00705000
*/*                                                                  */ 00762000
*/*  METHOD OF ACCESS                                                */ 00772000
*/*      BAL  - A DSECT CARD SHOULD PRECEDE MACRO CALL.  USING ON    */ 00782000
*/*             INFMJFCB GIVES ADDRESSABILITY FOR ALL SYMBOLS.       */ 00792000
*/*      PL/S - DCL JFCBPTR PTR                                      */ 00794000
*/*                                                                  */ 00796000
*/*  F.E.'S                                                          */ 00798000
*/*      MICROFICHE LISTING - IEFJFCBN                               */ 00798400
*/*                                                                  */ 00798800
*/*  DEVELOPERS                                                      */ 00799200
*/*      BAL LISTING  - SPECIFY LIST=YES ON MACRO CALL.              */ 00799600
*/*      PL/S LISTING - SPECIFY %IHALIST='YES' BEFORE INCLUDE.       */ 00799700
*/*                                                                  */ 00799800
*/*      FOR INTEGRATION A LISTING SHOULD NOT BE REQUESTED.          */ 00799900
*/*                                                                  */ 00800100
*/*  CHANGE ACTIVITY = YA05186                               @YA05186*/ 00800300
*/*                                                                  */ 00800500
*/* A - DECLARED STRUCTURE TO THE JFCAMPTR FIELD.  THE       @YA05186*/ 00800700
*/*     STRUCTURE SHOWS THE PLACEMENT OF THE SVA WITHIN      @YA05186*/ 00800900
*/*     THE 4 CHARACTER FIELD.                               @YA05186*/ 00801100
*/* **************************************************************** */ 00801300
*%GOTO JFCBL2;  /*                                                      00802000
         PUSH  PRINT                                                    00802400
         AIF   ('&LIST' EQ 'YES').JFCB1                                 00802800
         PRINT OFF                                                      00803200
.JFCB1   ANOP                                                           00803600
         SPACE 1                                                        00804000
         DS    0F                                                       00810000
INFMJFCB EQU   *                                                        00900000
JFCBQNAM DS    0CL8 -    PROCESS QUEUE NAME SPECIFIED BY THE QNAME      00910000
*                        KEYWORD  (TCAM)                                00920000
JFCBDSNM DS    CL44 -    DATA SET NAME                                  01000000
JFCIPLTX DS    0CL7 -    MODULE NAME OF NETWORK CONTROL PROGRAM (TCAM)  01050000
*                                                                ICB391 01060000
JFCBELNM DS    CL8 -     ELEMENT NAME OR RELATIVE GENERATION NUMBER.    01100000
*                        TYPE OF AREA (INDEX, PRIME OR OVERFLOW) FOR    01200000
*                        AN INDEXED SEQUENTIAL DATA SET ONLY.           01300000
JFCBTSDM DS    B -       JOB MANAGEMENT/DATA MANAGEMENT INTERFACE       01400000
JFCCAT   EQU   X'80' -   DATA SET IS CATALOGED                          01500000
JFCVSL   EQU   X'40' -   VOLUME SERIAL LIST HAS BEEN CHANGED            01600000
JFCSDS   EQU   X'20' -   DATA SET IS A SYSIN OR SYSOUT DATA SET         01700000
JFCTTR   EQU   X'10' -   A JOB STEP IS TO BE RESTARTED.  USE JFCBOTTR   01800000
*                        INSTEAD OF DS1LSTAR FIELD TO REPOSITION DATA   01850000
*                        SET IF AUTOMATIC STEP RESTART OCCURS.  (THIS   01900000
*                        JOB HAD ABEND PROCESSING FOR A DATA SET OPENED 01950000
*                        FOR MOD.)                                      02000000
JFCNWRIT EQU   X'08' -   DO NOT WRITE BACK THE JFCB DURING OPEN         02100000
*                        PROCESSING                                     02200000
JFCNDSCB EQU   X'04' -   DO NOT MERGE DSCB OR LABEL FIELDS INTO THIS    02300000
*                        JFCB                                           02400000
JFCNDCB  EQU   X'02' -   DO NOT MERGE DCB FIELDS INTO THIS JFCB         02500000
JFCPAT   EQU   X'01' -   THE PATTERNING DSCB IS COMPLETE                02600000
JFCBDSCB DS    CL3 -     TTR ADDRESS OF THE FORMAT 1 DSCB FOR DATA SET  02700000
*                        PART ON THE FIRST VOLUME OF THE DATA SET       02750000
*                                                                ICB398 02752000
JFCFCBID DS    0CL4 -    FORMS CONTROL BUFFER IMAGE IDENTIFICATION FOR  02760000
*                        THE 3211 PRINTER OR DATA PROTECTION IMAGE      02760400
*                        IDENTIFICATION FOR THE 3525 CARD PUNCH WITH    02760800
*                        THE READ AND PRINT FEATURES OR FORMAT RECORD   02763000
*                        ID                                      MDC007 02765300
JFCBFRID DS    0CL4 -    LAST 4 CHARACTERS OF A PDS MEMBER TO BE USED   02767500
*                        IN THE INTERPRETATION OF DOCUMENTS READ BY     02769700
*                        3886 DEVICE FOR THIS STEP               MDC024 02771900
JFCAMCRO DS    BL2 -     VSAM CHECKPOINT/RESTART OPTION INDICATORS      02774100
*                                                                ICB438 02776300
JFCAMSTR DS    H -       NUMBER OF STRINGS                       ICB438 02778500
JFCBADBF DS    H -       NUMBER OF DATA BUFFERS                  ICB438 02780700
JFCNLREC DS    H -       LOGICAL RECORD LENGTH FOR VSAM          ICB438 02782900
JFCVINDX DS    H -       MASS STORAGE SYSTEM COMMUNICATOR (MSSC) VOLUME 02787300
*                        SELECTION INDEX  (MDC308)             @Z30LP9A 02793300
JFCBLTYP DS    B -       LABEL TYPE                                     02800000
JFCRSV38 EQU   X'80',,C'X' RESERVED                                     02810000
JFCBAL   EQU   X'40' -   AMERICAN NATIONAL STANDARD TAPE LABELS (AL OR  02850000
*                        IF BIT 4 IS ALSO ON, AUL)                      02852000
JFCBLTM  EQU   X'20' -   UNLABELLED TAPE CREATED BY DOS MAY HAVE        02860000
*                        LEADING TAPE MARK.  OPEN/CLOSE/EOV AND RESTART 02870000
*                        MUST SPACE OVER A TAPE MARK IF ONE EXISTS.     02880000
*                                                                ICB398 02890000
JFCBLP   EQU   X'10' -   BYPASS LABEL PROCESSING                        02900000
JFCSUL   EQU   X'0A' -   USER LABEL                                     03000000
JFCNSL   EQU   X'04' -   NONSTANDARD LABEL                              03100000
JFCSL    EQU   X'02' -   STANDARD LABEL                                 03200000
JFCNL    EQU   X'01' -   NO LABEL                                       03300000
JFCBOTTR DS    0CL3 -    DASD MOD DATA SET - IF AUTOMATIC STEP RESTART  03400000
*                        WAS REQUESTED, TTR OF THE END-OF-DATA          03500000
*                        INDICATOR EXISTING WHEN THE DATA SET WAS FIRST 03600000
*                        OPENED DURING THE ORIGINAL EXECUTION OF THE    03700000
*                        CURRENT STEP                                   03750000
JFCBUFOF DS    FL1 -     TAPE DATA SET - THIS FIELD CONTAINS THE BUFFER 03800000
*                        OFFSET (DCB SUBPARAMETER VALUE)                03810000
JFCBFOFL EQU   X'80' -   IF 1, THE OFFSET EQUALS FOUR AND THE BUFFER    03850000
*                        OFFSET FIELD OF EACH BLOCK (D-FORMAT RECORDS)  03860000
*                        CONTAINS THE BLOCK LENGTH (SPECIFIED BY        03870000
*                        BUFOFF=L).                                     03872000
*                        IF 0, THE OFFSET IS AS SPECIFIED IN THE        03874000
*                        REMAINING SEVEN BITS AND THE BUFFER OFFSET     03876000
*                        FIELD OF EACH BLOCK DOES NOT CONTAIN THE       03878000
*                        BLOCK LENGTH.                                  03878400
JFCFUNC  DS    0B -      FUNCTION INDICATORS FOR THE 3525 CARD PUNCH    03880000
*                        (SPECIFIED BY THE FUNC PARAMETER)       ICB392 03882000
JFCFNCBI EQU   X'80' -   I - INTERPRET (PUNCH AND PRINT TWO LINES)      03890000
*                                                                ICB392 03890400
JFCFNCBR EQU   X'40' -   R - READ                                ICB392 03892000
JFCFNCBP EQU   X'20' -   P - PUNCH                               ICB392 03894000
JFCFNCBW EQU   X'10' -   W - PRINT                               ICB392 03896000
JFCFNCBD EQU   X'08' -   D - DATA PROTECTION                     ICB392 03898000
JFCFNCBX EQU   X'04' -   X - THIS DATA SET IS TO BE PRINTED.  THIS MAY  03898400
*                        BE CODED WITH PW OR RPW TO DISTINGUISH THE     03898500
*                        DATA SET TO BE PRINTED FROM THE DATA SET TO    03898600
*                        BE PUNCHED.                             ICB392 03898700
JFCFNCBT EQU   X'02' -   T - TWO-LINE PRINT SUPPORT REQUEST.  THE       03898800
*                        SECOND PRINT LINE IS LOCATED ON CARD LINE      03898900
*                        THREE.                                  ICB392 03899000
JFCRSV31 EQU   X'01',,C'X' RESERVED                                     03899200
JFCBFLSQ DS    H -       FOR MAGNETIC TAPE DEVICES, FILE SEQUENCE       03900000
*                        NUMBER                                         04000000
JFCBVLSQ DS    H -       VOLUME SEQUENCE NUMBER                         04100000
JFCBMASK DS    0CL8 -    DATA MANAGEMENT MASK                           04200000
JFCBOPS1 DS    BL5 -     OPEN ROUTINE INTERNAL SWITCHES                 04300000
JFCBFLG1 DS    B -       FLAG BYTE                                      04400000
JFCSTAND EQU   X'80' -   VOLUME LABEL PROCESSING STANDARD               04500000
JFCSLCRE EQU   X'40' -   CREATION OF A STANDARD LABEL IS NECESSARY      04600000
JFCSLDES EQU   X'20' -   DESTRUCTION OF A STANDARD LABEL IS NECESSARY   04800000
JFCDUAL  EQU   X'10' -   DUAL-DENSITY CHECK DETECTED                    05000000
JFCOPEN  EQU   X'0F' -   OPEN ROUTINE INTERNAL SWITCHES                 05100000
JFCBPWBP EQU   X'01' -   PASSWORD BYPASS INDICATOR               MDC010 05150000
JFCBFLG2 DS    B -       FLAG BYTE OF OPEN SWITCHES                     05200000
JFCINOP  EQU   X'80' -   TREAT THE INOUT OPTION OF OPEN AS INPUT        05300000
JFCOUTOP EQU   X'40' -   TREAT THE OUTIN OPTION OF OPEN AS OUTPUT       05400000
JFCDEFER EQU   X'20' -   SET ONLY IN A JFCB RECORDED IN A DATA SET      05500000
*                        DESCRIPTOR RECORD (DSDR) BY THE CHECKPOINT     05510000
*                        ROUTINE.  INDICATES THAT THE DATA SET RELATED  05520000
*                        TO THE JFCB IS BEING PROCESSED SEQUENTIALLY,   05550000
*                        AT THE CHECKPOINT, ON A VOLUME OTHER THAN THE  05600000
*                        VOLUME ON WHICH PROCESSING BEGAN IN THE        05700000
*                        CURRENT STEP.  WHEN RESTART OCCURS, THIS BIT   05800000
*                        CAUSES DEFERRED VOLUME MOUNTING.               05900000
JFCNRPS  EQU   X'20' -   USE BY OPEN ROUTINES - SET TO INDICATE THAT    05950000
*                        THIS DATA SET RESIDES ON A NON-RPS DEVICE.     05960000
*                        RESET TO ZERO WHEN OPEN PROCESSING IS          05970000
*                        COMPLETED.                              ICB495 05980000
JFCMODNW EQU   X'10' -   DISPOSITION OF THIS DATA SET HAS BEEN CHANGED  06000000
*                        FROM MOD TO NEW.  DISPOSITION (IN JFCBIND2)    06100000
*                        WILL BE RESTORED TO MOD AFTER OPEN.            06200000
JFCSDRPS EQU   X'08' -   USE SEARCH DIRECT FOR ROTATIONAL POSITION      06202000
*                        SENSING (RPS) DEVICES                   ICB398 06204000
JFCTRACE EQU   X'04' -   GTF TRACE IS TO OCCUR DURING OPEN/CLOSE/EOV    06210000
*                        AND DYNAMIC ALLOCATION PROCESSING OF DCB       06220000
*                                                                ICB392 06230000
JFCBBUFF EQU   X'02' -   INDICATOR TO OPEN THAT A NON-ZERO VALUE IN     06250000
*                        JFCBOTTR IS NOT TO PREVENT THE NORMAL STORING  06260000
*                        BY OPEN OF A TTR IN JFCBOTTR.  BEFORE OPEN -   06270000
*                        JFCBUFOF (OFFSET 67) CONTAINS A BUFFER OFFSET  06272000
*                        OR INVALID INFORMATION RESULTING FROM A        06274000
*                        JFCB-TO-JFCB MERGE.  AFTER OPEN - OPEN MAY     06276000
*                        HAVE STORED A TTR IN JFCBOTTR (OFFSET 67), IN  06278000
*                        WHICH CASE OPEN WILL HAVE SET THIS BIT TO      06278400
*                        ZERO.                                          06278800
JFCRCTLG EQU   X'01' -   OPEN HAS UPDATED THE TTR.  SCHEDULER STEP      06280000
*                        TERMINATION ROUTINE IS TO RECATALOG THIS DATA  06282000
*                        SET AND PLACE IN THE CATALOG ENTRY THE DSCB    06290000
*                        TTR CONTAINED IN JFCBDSCB IF THIS DATA SET IS  06292000
*                        CATALOGED.                              ICB398 06294000
JFCBOPS2 DS    B -       OPEN ROUTINE INTERNAL SWITCHES                 06300000
JFCBCRDT DS    CL3 -     DATA SET CREATION DATE (YDD, Y=YEAR AND        06400000
*                        DD=DAY)                                        06450000
JFCBXPDT DS    CL3 -     DATA SET EXPIRATION DATE (YDD)                 06500000
JFCBIND1 DS    B -       INDICATOR BYTE 1                               06700000
JFCRLSE  EQU   X'C0' -   RELEASE EXTERNAL STORAGE                       07000000
JFCLOC   EQU   X'30' -   DATA SET HAS BEEN LOCATED                      07100000
JFCADDED EQU   X'0C' -   NEW VOLUME HAS BEEN ADDED TO THE DATA SET      07200000
JFCGDG   EQU   X'02' -   DATA SET IS A MEMBER OF A GENERATION DATA      07300000
*                        GROUP                                          07400000
JFCPDS   EQU   X'01' -   DATA SET IS A MEMBER OF A PARTITIONED DATA SET 07500000
         SPACE 1                                                        07600000
