*%JSCBL1 : ;                                                            01210000
*                                                                       01220000
*/* **************************************************************** */ 01600000
*/*                                                                  */ 02000000
*/*            ***** JOB/STEP CONTROL BLOCK *****                    */ 02400000
*/*                                                                  */ 02800000
*/*  OS/VS2 SU64, 04/13/78, LEVEL=1                                  */ 02860000
*/*  PTF FOR APAR OZ95568                                    @ZA95568*/ 02880000
*/*                                                                  */ 02900000
*/*  METHOD OF ACCESS                                                */ 02910000
*/*      PL/S - %INCLUDE SYSLIB(IKJTCB) TO DEFINE TCBJSCB            */ 02920000
*/*      BAL  - L     REG,TCBJSCB                                    */ 02930000
*/*             USING IEZJSCB,REG                                    */ 02940000
*/*                                                                  */ 02950000
*/*             WHERE REG IS ANY REGISTER OTHER THAN ZERO GIVES      */ 02960000
*/*             ADDRESSABILITY FOR ALL SYMBOLS.                      */ 02970000
*/*                                                                  */ 02980000
*/*  NOTE                                                            */ 02990000
*/*      IN ADDITION TO THE MANDATORY USE OF THIS MACRO FOR          */ 03000000
*/*      REFERENCES TO THE JSCB, MODULES IN 0S/VS1 AND OS/VS2 WHICH  */ 03010000
*/*      ALLOCATE AND/OR FREE THE JSCB ARE REQUIRED TO USE THE       */ 03020000
*/*      GETJSCB AND FREEJSCB MACROS.                                */ 03030000
*/*                                                                  */ 03040000
*/*  FUNCTION                                                        */ 03050000
*/*      COMMUNICATION OF JOB OR STEP RELATED DATA ITEMS             */ 03060000
*/*                                                                  */ 06800000
*/*  CHANGE ACTIVITY -                                               */ 06850000
*/*      CODES: OZ95568                                      @ZA95568*/ 06900000
*/*                                                                  */ 06950000
*/* **************************************************************** */ 07000000
*/* JSCRIUCP - ADDRESS OF THE DYNAMIC ALLOCATION             @ZA95568*/ 07050000
*/*            COMMUNICATION TABLE.                          @ZA95568*/ 07100000
*                                                                       07210000
*%GOTO JSCBL2;  /*                                                      07220000
*                                                                       07230000
IEZJSCB  DSECT                                                          07600000
         ORG   IEZJSCB+188 -  ALLOWS ADDRESSABILITY FROM TCBJSCB        08000000
         SPACE                                                          08400000
